# AI Provider Config
# Set to false to lock users out of API key input — all calls use the server-side key.
# Set VITE_ACTIVE_PROVIDER to switch which server-side backend is used (deepseek | gemini).
VITE_USE_USER_API_KEY=false
VITE_ACTIVE_PROVIDER=deepseek
VITE_DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here
# Gemini keys — add a second key to enable round-robin rotation (prevents quota failures).
# Calls alternate between KEY_1 and KEY_2. On a 429/quota error the other key is retried automatically.
VITE_GEMINI_API_KEY=your-gemini-api-key-here
VITE_GEMINI_API_KEY_2=your-second-gemini-api-key-here

# Firebase Config (required — used for auth and cloud data sync)
VITE_FIREBASE_API_KEY=YOUR_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=YOUR_AUTH_DOMAIN
VITE_FIREBASE_PROJECT_ID=YOUR_PROJECT_ID
VITE_FIREBASE_STORAGE_BUCKET=YOUR_STORAGE_BUCKET
VITE_FIREBASE_MESSAGING_SENDER_ID=YOUR_MESSAGING_SENDER_ID
VITE_FIREBASE_APP_ID=YOUR_APP_ID
