{
  "expo": {
    "name": "Resumeow",
    "slug": "resumeow",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "resumeow",
    "userInterfaceStyle": "automatic",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "bundleIdentifier": "com.resumeow.app",
      "supportsTablet": false
    },
    "android": {
      "package": "com.resumeow.app",
      "adaptiveIcon": {
        "backgroundColor": "#ffffff"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-document-picker",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Resumeow to access your photos."
        }
      ],
      "expo-web-browser"
    ]
  }
}
